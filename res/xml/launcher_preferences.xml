<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto">

    <androidx.preference.PreferenceScreen
        android:key="bluenixx_category_home"
        android:persistent="false"
        android:title="@string/bluenixx_category_home">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_workspace_lock"
            android:persistent="true"
            android:title="@string/settings_lock_layout_title"
            android:summaryOn="@string/settings_lock_layout_summary_on"
            android:summaryOff="@string/settings_lock_layout_summary_off" />

        <!--
          LAUNCHER_ADD_NEW_APPS_TO_HOME_SCREEN_ENABLED(613)
          LAUNCHER_ADD_NEW_APPS_TO_HOME_SCREEN_DISABLED(614)
        -->
        <SwitchPreferenceCompat
            android:key="pref_add_icon_to_home"
            android:title="@string/auto_add_shortcuts_label"
            android:summary="@string/auto_add_shortcuts_description"
            android:defaultValue="true"
            android:persistent="true"
            launcher:logIdOn="613"
            launcher:logIdOff="614" />

        <SwitchPreferenceCompat
            android:key="pref_desktop_show_labels"
            android:title="@string/desktop_show_labels"
            android:defaultValue="true"
            android:persistent="true" />

        <SwitchPreferenceCompat
            android:key="pref_show_hotseat_qsb"
            android:title="@string/pref_show_hotseat_qsb_title"
            android:summary="@string/pref_show_hotseat_qsb_summary"
            android:defaultValue="false"
            android:persistent="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_sleep_gesture"
            android:persistent="true"
            android:title="@string/pref_sleep_gesture_title"
            android:summary="@string/pref_sleep_gesture_summary" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="pref_enable_minus_one"
            android:summary="@string/pref_show_google_now_summary"
            android:title="@string/title_show_google_app" />

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_home_icon_scale"
            android:title="@string/home_icon_scale"
            android:defaultValue="100"
            android:max="130"
            android:persistent="true"
            launcher:min="70"
            launcher:seekBarIncrement="5"
            launcher:showSeekBarValue="true" />

    </androidx.preference.PreferenceScreen>

    <androidx.preference.PreferenceScreen
        android:key="bluenixx_category_drawer"
        android:persistent="false"
        android:title="@string/bluenixx_category_drawer">

        <SwitchPreferenceCompat
            android:key="pref_drawer_open_keyboard"
            android:title="@string/drawer_open_keyboard_title"
            android:summary="@string/drawer_open_keyboard_summary"
            android:defaultValue="false"
            android:persistent="true" />

        <SwitchPreferenceCompat
            android:key="pref_drawer_show_labels"
            android:title="@string/drawer_show_labels"
            android:defaultValue="true"
            android:persistent="true" />

        <ListPreference
            android:key="pref_drawer_search_position"
            android:title="@string/drawer_search_position_title"
            android:summary="@string/drawer_search_position_summary"
            android:entries="@array/drawer_search_position_entries"
            android:entryValues="@array/drawer_search_position_values"
            android:defaultValue="bottom"
            android:persistent="true" />

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_drawer_icon_scale"
            android:title="@string/drawer_icon_scale"
            android:defaultValue="100"
            android:max="130"
            android:persistent="true"
            launcher:min="100"
            launcher:seekBarIncrement="5"
            launcher:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="pref_launcher_blur_enabled"
            android:title="@string/launcher_blur_enabled"
            android:defaultValue="true"
            android:persistent="true" />

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_launcher_blur_amount"
            android:title="@string/launcher_blur_amount"
            android:dependency="pref_launcher_blur_enabled"
            android:defaultValue="100"
            android:max="100"
            android:persistent="true"
            launcher:min="0"
            launcher:seekBarIncrement="5"
            launcher:showSeekBarValue="true" />

        <Preference
            android:key="pref_drawer_background_color_light"
            android:title="@string/drawer_background_color_light_title"
            android:summary="@string/drawer_background_color_summary"
            android:persistent="false" />

        <Preference
            android:key="pref_drawer_background_color_dark"
            android:title="@string/drawer_background_color_dark_title"
            android:summary="@string/drawer_background_color_summary"
            android:persistent="false" />

        <androidx.preference.PreferenceScreen
            android:key="pref_suggestions"
            android:title="@string/pref_suggestions_title"
            android:summary="@string/pref_suggestions_summary"
            android:persistent="false">

            <intent android:action="android.settings.ACTION_CONTENT_SUGGESTIONS_SETTINGS" />
        </androidx.preference.PreferenceScreen>

    </androidx.preference.PreferenceScreen>

    <androidx.preference.PreferenceScreen
        android:key="bluenixx_category_icons"
        android:persistent="false"
        android:title="@string/bluenixx_category_icons">

        <ListPreference
            android:key="pref_icon_pack"
            android:title="@string/icon_pack"
            android:defaultValue=""
            android:persistent="true" />

        <SwitchPreferenceCompat
            android:key="pref_allapps_themed_icons"
            android:title="@string/pref_themed_icons_title"
            android:summary="@string/pref_themed_icons_summary"
            android:defaultValue="false"
            android:persistent="true" />

        <com.android.launcher3.settings.NotificationDotsPreference
            android:key="pref_icon_badging"
            android:title="@string/notification_dots_title"
            android:persistent="false"
            android:widgetLayout="@layout/notification_pref_warning" />

    </androidx.preference.PreferenceScreen>

    <androidx.preference.PreferenceScreen
        android:key="bluenixx_category_navigation_bar"
        android:persistent="false"
        android:title="@string/bluenixx_category_navigation_bar">

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_gesture_bar_width"
            android:title="@string/gesture_bar_width_title"
            android:summary="@string/gesture_bar_width_summary"
            android:defaultValue="72"
            android:max="100"
            android:persistent="true"
            launcher:min="20"
            launcher:seekBarIncrement="2"
            launcher:showSeekBarValue="true" />

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_gesture_bar_thickness"
            android:title="@string/gesture_bar_thickness_title"
            android:summary="@string/gesture_bar_thickness_summary"
            android:defaultValue="4"
            android:max="12"
            android:persistent="true"
            launcher:min="2"
            launcher:seekBarIncrement="1"
            launcher:showSeekBarValue="true" />

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_gesture_bar_height"
            android:title="@string/gesture_bar_height_title"
            android:summary="@string/gesture_bar_height_summary"
            android:defaultValue="0"
            android:max="40"
            android:persistent="true"
            launcher:min="0"
            launcher:seekBarIncrement="2"
            launcher:showSeekBarValue="true" />

        <ListPreference
            android:key="pref_gesture_bar_color"
            android:title="@string/gesture_bar_color_title"
            android:summary="@string/gesture_bar_color_summary"
            android:entries="@array/gesture_bar_color_entries"
            android:entryValues="@array/gesture_bar_color_values"
            android:defaultValue="#FFFFFFFF"
            android:persistent="true" />

        <SeekBarPreference
            android:layout="@layout/bluenixx_expressive_slider"
            android:key="pref_gesture_bar_opacity"
            android:title="@string/gesture_bar_opacity_title"
            android:summary="@string/gesture_bar_opacity_summary"
            android:defaultValue="100"
            android:max="100"
            android:persistent="true"
            launcher:min="10"
            launcher:seekBarIncrement="5"
            launcher:showSeekBarValue="true" />

    </androidx.preference.PreferenceScreen>

    <androidx.preference.PreferenceScreen
        android:key="bluenixx_category_advanced"
        android:persistent="false"
        android:title="@string/bluenixx_category_advanced">

        <Preference
            android:key="pref_trust_apps"
            android:title="@string/trust_apps_manager_name" />

    </androidx.preference.PreferenceScreen>

</androidx.preference.PreferenceScreen>
